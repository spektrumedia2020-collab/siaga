# Supabase Configuration Template
# Copy this file to .env.local and fill with your credentials
# NEVER commit actual credentials to repository!

# Project URL from Supabase Dashboard > Settings > API
VITE_SUPABASE_URL=your_supabase_project_url_here

# Anon Public Key from Supabase Dashboard > Settings > API > anon key  
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Optional: Service role key for admin operations (KEEP SECRET - server side only)
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here