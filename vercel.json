{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    },
    {
      "src": "api/users.ts",
      "use": "@vercel/node"
    },
    {
      "src": "api/users/market-heads.ts",
      "use": "@vercel/node"
    },
    {
      "src": "api/markets.ts",
      "use": "@vercel/node"
    },
    {
      "src": "api/markets/[id]/index.ts",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "/api/users/market-heads",
      "dest": "/api/users/market-heads.ts"
    },
    {
      "src": "/api/users/(.*)",
      "dest": "/api/users.ts"
    },
    {
      "src": "/api/markets/(.*)",
      "dest": "/api/markets/[id]/index.ts"
    },
    {
      "src": "/api/markets",
      "dest": "/api/markets.ts"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}